{
  "name": "habittracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/pwa.test.cjs tests/expenses.test.mjs tests/appearance.test.mjs tests/cloud.test.mjs",
    "build:web": "node scripts/build-web.cjs",
    "preview:web": "node --env-file-if-exists=.env.openclaw.local scripts/serve-web.cjs",
    "release:check": "node scripts/check-release.cjs",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:stores": "npm run release:check && npx eas-cli@latest build --platform all --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production"
  },
  "private": true
}
